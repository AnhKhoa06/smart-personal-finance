PORT=3000
NODE_ENV=development
# Địa chỉ frontend (dùng cho CORS và cookie)
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=finance_db

# Hai secret phải KHÁC nhau, dài từ 32 ký tự. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Độ tốn kém của bcrypt (10 đến 15). Mỗi +1 là chậm gấp đôi.
BCRYPT_COST=12
